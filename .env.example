# Copy to .env and fill in. Never commit .env.

# Data: leave DATABASE_URL empty to run on in-memory demo data (resets on restart).
# Local SQL Server from docker-compose.yml:
# DATABASE_URL="sqlserver://localhost:1433;database=crm;user=sa;password=Local_Dev_Passw0rd!;encrypt=true;trustServerCertificate=true"
DATABASE_URL=""
# DATA_BACKEND=memory | sqlserver   (defaults to sqlserver when DATABASE_URL is set)

# Vista JC company the CRM pushes to: 201 (test company) until UAT sign-off, then 9.
VISTA_COMPANY=201

# Shared secret App Xchange's HTTP connector sends as x-api-key. 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY=""

# Sign-in: "dev" shows a sign-in-as switcher (local only); "entra" uses Azure App Service
# Authentication (Microsoft Entra ID). Production defaults to entra.
AUTH_MODE=dev

# Base URL used by `npm run mock:appxchange`
CRM_URL=http://localhost:3000
